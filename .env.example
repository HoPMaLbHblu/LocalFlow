# Copy this file to `.env` and adjust as needed. Every setting is optional.

# Address to listen on. Only loopback addresses are allowed unless LOCALFLOW_ALLOW_REMOTE=true.
LOCALFLOW_HOST=127.0.0.1
LOCALFLOW_PORT=3000

# Set to true to allow binding to a non-local address (e.g. 0.0.0.0).
# There is no login, so anyone who can reach the port can run scripts. Leave this off.
LOCALFLOW_ALLOW_REMOTE=false

# SQLite database file (created automatically).
DATABASE_URL=sqlite://localflow.db

# Folders scripts may read and change, separated by `;` on Windows or `:` on macOS/Linux.
# Defaults to your home folder.
# LOCALFLOW_ALLOWED_DIRS=C:\Users\you\Downloads;C:\Users\you\Documents

# Scripts running longer than this are stopped.
LOCALFLOW_SCRIPT_TIMEOUT_SECS=30

# Log verbosity: error, warn, info, debug, trace.
RUST_LOG=localflow=info
